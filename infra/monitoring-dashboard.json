{
  "displayName": "Sentinel Continuity",
  "mosaicLayout": {
    "columns": 12,
    "tiles": [
      {
        "xPos": 0, "yPos": 0, "width": 4, "height": 4,
        "widget": {
          "title": "Obligations admitted",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/sentinel_obligations_created\"",
                  "aggregation": { "alignmentPeriod": "3600s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" }
                }
              }
            }]
          }
        }
      },
      {
        "xPos": 4, "yPos": 0, "width": 4, "height": 4,
        "widget": {
          "title": "Checkpoints fired: the system waking on its own",
          "xyChart": {
            "chartOptions": { "mode": "COLOR" },
            "dataSets": [{
              "plotType": "STACKED_BAR",
              "targetAxis": "Y1",
              "timeSeriesQuery": {
                "timeSeriesFilter": {
                  "filter": "metric.type=\"logging.googleapis.com/user/sentinel_checkpoints_fired\"",
                  "aggregation": { "alignmentPeriod": "3600s", "perSeriesAligner": "ALIGN_SUM", "crossSeriesReducer": "REDUCE_SUM" }
                }
              }
            }]
          }
        }
      },
