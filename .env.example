# Copy to .env and fill in. .env is gitignored and must never be committed.

GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_PROJECT_NUMBER=

# Regional services: Firestore, Cloud Tasks, Cloud Run, KMS, Model Armor.
GOOGLE_CLOUD_REGION=

# Gemini 3.5 is served only from the global endpoint, not from the regional one.
# Setting this to the region produces a 404 that reads like the model is missing.
GOOGLE_CLOUD_LOCATION=
GEMINI_MODEL=

TASKS_QUEUE=
TASKS_SERVICE_ACCOUNT=
PUBSUB_TOPIC=
MODEL_ARMOR_TEMPLATE=
KMS_KEY=
WRAPPED_KEY_SECRET=
INBOUND_BUCKET=

# Deterministic code paths that must not depend on a model.
EVIDENCE_GATE=on

# Set by the deploy script so the engine can address itself when enqueuing timers.
ENGINE_BASE_URL=

# Outbound notification. Google Chat incoming webhooks need a Workspace account,
# so the options here are log, sheets, or gmail. See services/engine/notify.py.
NOTIFIER=log
NOTIFY_FROM=
NOTIFY_TO=
NOTIFY_SHEET_ID=
GMAIL_OAUTH_SECRET=gmail-oauth
